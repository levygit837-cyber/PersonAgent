# PersonAgent local development stack.
#
# Usage:
#     cp docker-compose.yml.example docker-compose.yml
#     cp .env.example .env
#     # edit .env and set POSTGRES_PASSWORD + any LLM API keys you want
#     docker compose up -d postgres
#     cd @backend && uv sync --extra dev && uv run alembic upgrade head
#     cd @backend && uv run personagent serve --port 8000 --reload
#
# Notes:
# - The real docker-compose.yml is gitignored (it can carry secrets); this
#   file is the version-controlled template. Keep them in sync when you
#   add new services.
# - The backend service is intentionally commented out -- most contributors
#   run it locally with hot reload via `personagent serve`. Uncomment it
#   if you prefer a fully containerised dev loop.

services:
  postgres:
    image: pgvector/pgvector:pg16
    container_name: personagent-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-personagent}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set in .env}
      POSTGRES_DB: ${POSTGRES_DB:-personagent}
    ports:
      - "${POSTGRES_PORT:-5433}:5432"
    volumes:
      - personagent_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10

  lightpanda:
    image: lightpanda/browser:nightly
    container_name: personagent-lightpanda
    restart: unless-stopped
    ports:
      - "${LIGHTPANDA_PORT:-9222}:9222"
    environment:
      LIGHTPANDA_DISABLE_TELEMETRY: "true"
    healthcheck:
      test:
        - CMD-SHELL
        - |
          perl -e 'use IO::Socket::INET; my $$s = IO::Socket::INET->new(PeerAddr=>"127.0.0.1", PeerPort=>9222, Proto=>"tcp", Timeout=>5); exit($$s ? 0 : 1);'
      interval: 10s
      timeout: 5s
      retries: 5

  # Uncomment to enable RabbitMQ for operational memory queue.
  # Only needed if MEMORY_QUEUE_ENABLED=true in .env
  #
  # rabbitmq:
  #   image: rabbitmq:3.13-management-alpine
  #   container_name: personagent-rabbitmq
  #   restart: unless-stopped
  #   environment:
  #     RABBITMQ_DEFAULT_USER: ${RABBITMQ_DEFAULT_USER:-personagent}
  #     RABBITMQ_DEFAULT_PASS: ${RABBITMQ_DEFAULT_PASS:?RABBITMQ_DEFAULT_PASS must be set in .env}
  #   ports:
  #     - "${RABBITMQ_PORT:-5672}:5672"
  #     - "${RABBITMQ_MANAGEMENT_PORT:-15672}:15672"
  #   healthcheck:
  #     test: ["CMD-SHELL", "rabbitmq-diagnostics -q ping"]
  #     interval: 10s
  #     timeout: 5s
  #     retries: 5

  backend:
    build:
      context: ./@backend
      dockerfile: Dockerfile
    container_name: personagent-backend
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      lightpanda:
        condition: service_healthy
    env_file: .env
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      DATABASE_URL: ""
      LIGHTPANDA_CDP_URL: http://lightpanda:9222
    ports:
      - "8000:8000"
    command: >
      personagent serve --host 0.0.0.0 --port 8000

  memory-worker:
    build:
      context: ./@backend
      dockerfile: Dockerfile
    container_name: personagent-memory-worker
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    env_file: .env
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      DATABASE_URL: ""
      MEMORY_QUEUE_URL: amqp://personagent:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/personagent
    command: >
      personagent memory-worker

volumes:
  personagent_pgdata:
    name: personagent_pgdata
