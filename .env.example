# ============================================================
# PersonAgent — Variáveis de Ambiente
# Copie para .env e ajuste conforme necessário
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=personagent
POSTGRES_PASSWORD=personagent_secret
POSTGRES_DB=personagent
DATABASE_URL=postgresql+asyncpg://personagent:personagent_secret@localhost:5433/personagent

# --- LLM / llama.cpp ---
LLAMA_SERVER_URL=http://localhost:8080/v1
LLAMA_SERVER_API_KEY=local
LLAMA_MODEL_PATH=/home/levybonito/.lmstudio/models/Jackrong/Qwen3.5-4B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF
LLAMA_CTX_SIZE=262144
LLAMA_N_GPU_LAYERS=999
LLAMA_TEMPERATURE=0.7
LLAMA_MAX_TOKENS=82000
LLAMA_CACHE_TYPE_K=turbo4
LLAMA_CACHE_TYPE_V=turbo4
LLAMA_REASONING=off
LLAMA_REASONING_BUDGET=2048
LLAMA_VERBOSE=false
LLAMA_THREADS=6
LLAMA_AUTO_START=false

# --- NVIDIA NIM ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=openai/gpt-oss-120b
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_STREAM_READ_TIMEOUT_SECONDS=0
NVIDIA_MODELS_CACHE_TTL_SECONDS=300

# --- DeepSeek official API ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=65536
DEEPSEEK_CONTEXT_WINDOW=1000000
DEEPSEEK_TIMEOUT_SECONDS=240
DEEPSEEK_STREAM_READ_TIMEOUT_SECONDS=0
DEEPSEEK_MODELS_CACHE_TTL_SECONDS=300

# --- ZenMux API ---
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_DEFAULT_MODEL=deepseek/deepseek-v4-flash-free
ZENMUX_MAX_TOKENS=65536
ZENMUX_CONTEXT_WINDOW=1000000
ZENMUX_TIMEOUT_SECONDS=240
ZENMUX_STREAM_READ_TIMEOUT_SECONDS=0
ZENMUX_MODELS_CACHE_TTL_SECONDS=300

# --- Operational RAG memory / embeddings ---
OPERATIONAL_MEMORY_ENABLED=true
OPERATIONAL_MEMORY_CAPTURE_TOOLS_ENABLED=true
OPERATIONAL_MEMORY_RECALL_ENABLED=true
OPERATIONAL_MEMORY_EMBEDDING_ENABLED=true
OPERATIONAL_MEMORY_MAX_CAPTURE_CHARS=24000
OPERATIONAL_MEMORY_CHUNK_MAX_CHARS=4000
OPERATIONAL_MEMORY_RECALL_TOP_K=6
OPERATIONAL_MEMORY_HOT_CACHE_SIZE=100
EMBEDDING_SERVER_URL=http://localhost:8081/v1
EMBEDDING_SERVER_API_KEY=local
EMBEDDING_MODEL=Qwen3-Embedding-8B-Q4_K_M.gguf
EMBEDDING_MODEL_PATH=/home/levybonito/.lmstudio/models/Qwen/Qwen3-Embedding-8B-GGUF
EMBEDDING_DIMENSIONS=4096
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_AUTO_START=false
EMBEDDING_PORT=8081
EMBEDDING_CTX_SIZE=32768
EMBEDDING_N_GPU_LAYERS=999
EMBEDDING_THREADS=6
EMBEDDING_PARALLEL=1

# --- Google Vertex AI ---
GOOGLE_API_KEY=
VERTEX_AUTH_MODE=auto
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_DEFAULT_MODEL=gemini-3.1-flash-lite-preview
VERTEX_TIMEOUT_SECONDS=240
VERTEX_STREAM_READ_TIMEOUT_SECONDS=0
VERTEX_MODELS_CACHE_TTL_SECONDS=300

# --- Kimi Code ---
KIMI_API_KEY=sk-kimi-your-key-here
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_DEFAULT_MODEL=kimi-for-coding
KIMI_MAX_TOKENS=32768
KIMI_CONTEXT_WINDOW=262144
KIMI_TIMEOUT_SECONDS=240
KIMI_STREAM_READ_TIMEOUT_SECONDS=0
KIMI_ANTHROPIC_VERSION=2023-06-01

# --- Aplicação ---
APP_NAME=PersonAgent
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Ferramentas ---
TOOLS_ENABLED=true
# Empty tool/output limits mean no PersonAgent cap; provider, OS, cancellation, and permission boundaries still apply.
TOOLS_MAX_ITERATIONS=
TOOLS_RESULT_MAX_CHARS=
TOOLS_READ_MAX_BYTES=10000000
TOOLS_READ_DEFAULT_LIMIT=10000
TOOLS_READ_MAX_LINES=100000
TOOLS_WEB_MAX_BYTES=10000000

# --- Memória ---
AUTO_MEMORY_ENABLED=false

# --- LightPanda Browser ---
LIGHTPANDA_ENABLED=true
LIGHTPANDA_PORT=9222
LIGHTPANDA_ADVERTISE_HOST=127.0.0.1
LIGHTPANDA_CDP_TIMEOUT_SECONDS=300
LIGHTPANDA_CDP_MAX_CONNECTIONS=64
LIGHTPANDA_CDP_URL=http://127.0.0.1:9222
LIGHTPANDA_TIMEOUT_MS=30000
LIGHTPANDA_SEARCH_BASE_URL=https://www.google.com/search
LIGHTPANDA_SESSION_TTL_SECONDS=900
LIGHTPANDA_MAX_SESSIONS=32

# --- Segurança ---
SECRET_KEY=change-me-in-production-please-use-256-bit-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
